{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "notifications": {
        "ClusterId": "notificationCluster",
        "Match": {
          "Path": "/hubs/notifications/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "notificationCluster": {
        "Destinations": {
          "primary": {
            "Address": "http://notification-service:5004"
          }
        }
      }      
    }
  }
}
